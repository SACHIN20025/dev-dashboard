# Server
PORT=5000
NODE_ENV=development

# Database (Task 3)
# Default: local SQLite file — zero setup, great for grading/demoing.
# To use MySQL or Postgres instead, set DB_DIALECT to "mysql" or "postgres"
# and fill in the connection fields below (see src/config/database.js).
DB_DIALECT=sqlite
DB_STORAGE=./data/devflow.sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devflow
DB_USER=postgres
DB_PASSWORD=changeme

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# AI feature (Task 4) — get a key at https://console.anthropic.com
# The AI endpoints work without this key too: they fall back to a
# clearly-labeled local heuristic so the app still runs end-to-end in a demo.
ANTHROPIC_API_KEY=

# CORS
CLIENT_ORIGIN=http://localhost:5173
